    <windowclass name="aptus_identity_dedicacion">
        <margins control="0,0,0,0" />
        <script file="scripts/char_identity_dedication_aptus.lua" />
        <sheetdata>
            <!-- Bounds relativos a Dedicación: origen (158,14) en Identidad. -->
            <stringcontrol name="label_dedication">
                <bounds>62,0,392,14</bounds><font>aptus_font_navigation_white</font>
                <static>DEDICACIÓN</static><disabled />
            </stringcontrol>
            <stringcontrol name="dedication">
                <bounds>62,15,392,24</bounds><font>aptus_font_navigation_white</font><nodrag />
                <script>
                    function onValueChanged() window.onDedicationEdited(getValue()); end
                    function onDrop(x, y, draginfo) return window.onDedicationDrop(draginfo); end
