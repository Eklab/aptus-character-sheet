    <windowclass name="aptus_identity_conflictos">
        <margins control="0,0,0,0" />
        <script file="scripts/char_identity_conflicts_aptus.lua" />
        <sheetdata>
            <!-- El signo + ya está dibujado en el fondo. -->
            <buttoncontrol name="add_conflict">
                <bounds>438,12,26,24</bounds><tooltip text="Añadir conflicto" />
                <script>function onButtonPress() window.addConflict(); end</script>
            </buttoncontrol>
            <button_iedit name="conflicts_iedit">
                <anchored merge="delete" /><bounds>412,14,20,20</bounds><edittarget>conflicts</edittarget>
            </button_iedit>
            <windowlist name="conflicts">
                <bounds>0,44,451,252</bounds>
                <class>aptus_conflict_row</class><datasource>.aptus.identity.conflicts</datasource>
                <sortby><field>order</field></sortby>
            </windowlist>
            <scrollbar name="conflicts_scrollbar">
                <anchored merge="delete" /><bounds>451,44,18,252</bounds>
                <frame name="scrollbar_base" offset="0,0,0,0" /><target>conflicts</target>
            </scrollbar>
        </sheetdata>
