            <stringcontrol name="label_weight">
                <bounds>250,100,70,18</bounds>
                <font>aptus_font_navigation_white</font>
                <static>PESO</static>
                <disabled />
            </stringcontrol>
            <stringcontrol name="label_years">
                <bounds>49,118,32,18</bounds>
                <font>aptus_font_navigation_white</font>
                <static>años</static>
                <disabled />
            </stringcontrol>
            <stringcontrol name="label_metres">
                <bounds>212,118,20,18</bounds>
                <font>aptus_font_navigation_white</font>
                <static>m</static>
                <disabled />
            </stringcontrol>
            <stringcontrol name="label_kilograms">
                <bounds>288,118,24,18</bounds>
                <font>aptus_font_navigation_white</font>
                <static>kg</static>
                <disabled />
            </stringcontrol>
            <stringcontrol name="label_description">
                <bounds>6,144,440,28</bounds>
                <font>aptus_font_navigation_white</font>
                <static>DESCRIPCIÓN FÍSICA</static>
                <disabled />
            </stringcontrol>
            <stringcontrol name="label_other_notes">
                <bounds>6,230,440,28</bounds>
                <font>aptus_font_navigation_white</font>
                <static>OTRAS NOTAS</static>
                <disabled />
            </stringcontrol>

            <!-- Referencia al catálogo: sólo el director puede asignarla por arrastre. -->
            <stringcontrol name="character_type">
                <bounds>45,72,290,18</bounds>
                <font>aptus_font_navigation_white</font><readonly /><nodrag />
                <tooltip text="Tipo de personaje: arrastrar desde el catálogo (sólo director)" />
                <script file="scripts/char_character_type_aptus.lua" />
            </stringcontrol>
            <!-- Campos nuevos: bounds relativos a Datos. Sin marcos ni fondos. -->
            <stringfield name="name">
                <bounds>10,32,294,18</bounds>
                <font>aptus_font_navigation_black</font><nodrag />
            </stringfield>
            <!-- age: valor numérico editable, conservando el tipo del nodo existente. -->
            <stringcontrol name="age">
                <bounds>10,118,30,18</bounds>
                <font>aptus_font_navigation_black</font>
                <center /><nodrag /><nodrop />
                <tooltip text="Número entero; sin unidades" />
                <integeronly />
                <script file="scripts/identity_numeric_aptus.lua" />
            </stringcontrol>
            <stringfield name="gender">
                <bounds>95,118,56,18</bounds>
                <font>aptus_font_navigation_black</font><nodrag />
            </stringfield>
            <!-- height: valor numérico editable, conservando el tipo del nodo existente. -->
            <stringcontrol name="height">
                <bounds>174,118,30,18</bounds>
                <font>aptus_font_navigation_black</font>
                <center /><nodrag /><nodrop />
                <tooltip text="Número decimal (punto o coma); sin unidades" />
                
                <script file="scripts/identity_numeric_aptus.lua" />
            </stringcontrol>
            <!-- weight: valor numérico editable, conservando el tipo del nodo existente. -->
            <stringcontrol name="weight">
                <bounds>250,118,30,18</bounds>
                <font>aptus_font_navigation_black</font>
                <center /><nodrag /><nodrop />
                <tooltip text="Número decimal (punto o coma); sin unidades" />
                
                <script file="scripts/identity_numeric_aptus.lua" />
            </stringcontrol>
            <stringfield name="appearance">
                <bounds>12,174,426,48</bounds>
                <font>aptus_font_navigation_black</font>
                <multilinespacing>14</multilinespacing><nodrag />
            </stringfield>
            <!-- Barra nativa: ocupa el margen derecho reservado dentro del recuadro. -->
            <scrollbar name="appearance_scrollbar">
                <anchored merge="delete" />
                <bounds>453,176,20,48</bounds>
                <frame name="scrollbar_base" offset="0,0,0,0" />
                <target>appearance</target>
            </scrollbar>
            <stringfield name="notes">
                <bounds>12,260,426,48</bounds>
                <font>aptus_font_navigation_black</font>
                <multilinespacing>14</multilinespacing><nodrag />
            </stringfield>
            <!-- Barra nativa: ocupa el margen derecho reservado dentro del recuadro. -->
            <scrollbar name="notes_scrollbar">
                <anchored merge="delete" />
                <bounds>453,264,20,48</bounds>
                <frame name="scrollbar_base" offset="0,0,0,0" />
                <target>notes</target>
            </scrollbar>
            <!-- Vista de prueba: comparte nodo, no sustituye portrait/token activos. -->
            <subwindow name="symbiote_appearances">
                <bounds>314,3,148,136</bounds>
                <noscroll /><invisible />
            </subwindow>
            <!-- Control nativo: portrait, token y token3Dflat; independiente de illustration. -->
            <picture_charsheet_v2 name="portrait">
                <anchored merge="delete" />
                <bounds>350,32,75,50</bounds>
                <script>
                    function onDrop(x, y, draginfo)
                        if WindowManager.getWindowReadOnlyState(window) then return false; end
                        return super.onDrop(x, y, draginfo);
                    end
                </script>
            </picture_charsheet_v2>
        </sheetdata>
    </windowclass>
