<?xml version="1.0" encoding="utf-8"?>

<root>

    <windowclass name="charsheet_abilities">
        <script file="scripts/char_abilities_aptus.lua" />
        <sheetdata>

            <!-- Marco principal -->
            <frame_char name="skillsframe">
                <anchored position="over" />
            </frame_char>

            <!-- Titulo -->
            <label_frametop name="skills_title">
                <anchored to="skillsframe" />
                <static text="Habilidades" />
            </label_frametop>

            <!-- CTA Edicion -->
            <buttoncontrol name="skills_editor_button">
                <anchored to="skillsframe">
                    <top offset="0" />
                    <right offset="-30" />
                    <size width="25" height="25" />
                </anchored>

                <icon normal="aptus_settings" pressed="aptus_settings" />

                <tooltip text="Editar habilidades" />

                <script>
                    function onButtonPress()
                        window.openSkillsEditor()
                    end
                </script>
            </buttoncontrol>

            <!-- Cabecera de columnas -->
            <stringcontrol name="skills_header_name">
                <anchored to="skillsframe">
                    <top offset="40" />
                    <left offset="45" />
                    <size width="140" height="25" />
                </anchored>
                <static text="HABILIDAD" />
            </stringcontrol>

            <stringcontrol name="skills_header_attribute">
                <anchored to="skillsframe">
                    <top offset="40" />
                    <left offset="190" />
                    <size width="40" height="25" />
                </anchored>
                <static text="ATR" />
            </stringcontrol>

            <stringcontrol name="skills_header_level">
                <anchored to="skillsframe">
                    <top offset="40" />
                    <left offset="235" />
                    <size width="50" height="25" />
                </anchored>
                <static text="VALOR" />
            </stringcontrol>

            <stringcontrol name="skills_header_roll">
                <anchored to="skillsframe">
                    <top offset="40" />
                    <left offset="310" />
                    <size width="85" height="25" />
                </anchored>
                <static text="TIRADA" />
            </stringcontrol>

            <!-- Lista unificada de habilidades -->
            <windowlist name="aptus_skills_list">
                <anchored to="skillsframe">
                    <left offset="20" />
                    <top offset="75" />
                    <right offset="-20" />
                    <bottom offset="-20" />
                </anchored>

                <datasource>.skills</datasource>
                <class>aptus_skill_row</class>

                <columns width="420" filldown="true" />

                <script>
                    function onFilter(w)
                        return window.filterSkills(w)
                    end

                    function onSortCompare(w1, w2)
                        return window.sortSkills(w1, w2)
                    end
                </script>
            </windowlist>

        </sheetdata>
    </windowclass>

</root>