        <!-- Ficha de personaje - Configuracion de Habilidades -->
        <includefile source="campaign/record_skills_editor_aptus.xml" />
        <!-- Ficha de personaje - Template - Edicion de Habilidades -->
        <includefile source="campaign/record_skill_editor_row_aptus.xml" />
        <script file="scripts/char_skill_editor_row_aptus.lua" />

        <!-- ENDIDAD HABILIDAD -->
        <includefile source="campaign/record_aptus_skill.xml" />

