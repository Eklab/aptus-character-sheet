<?xml version="1.0" encoding="utf-8"?>

<root version="4.1">
    <properties>
        <name>APTUS Character Sheet</name>
        <version>0.1</version>
        <author>APTUS</author>
        <description>Ficha de personaje para APTUS.</description>

        <ruleset>
            <name>CoreRPG</name>
        </ruleset>
    </properties>

    <base>
        <!-- Gestores globales -->
        <script name="APTUSSkillsManager" file="scripts/manager_aptus_skills.lua" />

        <!-- Textos traducibles -->
        <includefile source="strings/strings_aptus.xml" />

        <!-- Ficha de personaje -->
        <includefile source="campaign/record_char_aptus.xml" />
        <!-- Ficha de personaje - Template - Fila de Atributos -->
        <includefile source="campaign/record_attribute_row_aptus.xml" />
        <!-- Ficha de personaje - Configuracion de Atributos -->
        <includefile source="campaign/record_attributes_editor_aptus.xml" />

        <!-- Ficha de personaje - Habilidades -->
        <includefile source="campaign/record_char_abilities_aptus.xml" />
        <!-- Ficha de personaje - Template - Fila de Habilidades -->
        <includefile source="campaign/record_skill_row_aptus.xml" />
        <!-- Ficha de personaje - Configuracion de Habilidades -->
        <includefile source="campaign/record_skills_editor_aptus.xml" />
        <!-- Ficha de personaje - Template - Edicion de Habilidades -->
        <includefile source="campaign/record_skill_editor_row_aptus.xml" />
        <script file="scripts/char_skill_editor_row_aptus.lua" />

        <!-- ENDIDAD HABILIDAD -->
        <includefile source="campaign/record_aptus_skill.xml" />

        <!-- Efectos -->
