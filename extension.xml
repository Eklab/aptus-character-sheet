        <includefile source="campaign/record_char_container_aptus.xml" />

        <includefile source="campaign/record_aptus_character_type.xml" />
        <includefile source="campaign/record_aptus_dedication_class.xml" />

        <!-- Ficha de personaje -->
        <includefile source="campaign/record_char_aptus.xml" />
        <!-- Ficha de personaje - Template - Fila de Atributos -->
        <includefile source="campaign/record_attribute_row_aptus.xml" />
        <includefile source="campaign/record_char_principal_aptus.xml" />
        <!-- Ficha de personaje - Configuracion de Atributos -->
        <includefile source="campaign/record_attributes_editor_aptus.xml" />

        <!-- Ficha de personaje - Habilidades -->
        <includefile source="campaign/record_char_abilities_aptus.xml" />
