<?xml version="1.0" encoding="utf-8"?>

<root version="4.1">
    <properties>
        <name>APTUS Character Sheet</name>
        <version>0.1</version>
        <author>APTUS</author>
        <description>Ficha de personaje para APTUS.</description>

        <ruleset>
            <name>CoreRPG</name>
        </ruleset>
    </properties>

    <base>
        <!-- Gestores globales -->
        <script name="APTUSDedication" file="scripts/manager_aptus_dedication.lua" />
        <script name="APTUSSkin" file="scripts/manager_aptus_skin.lua" />
        <script name="APTUSCharacterTypes" file="scripts/manager_aptus_character_types.lua" />
        <script name="APTUSSymbioteAppearance" file="scripts/manager_aptus_symbiote_appearance.lua" />
        <!-- Temporal: prueba manual de assets en el chat, sin alterar avisos de modo. -->
        <script name="APTUSAppearanceChatTest" file="scripts/test_appearance_chat_assets.lua" />
        <script name="APTUSCharacterManager" file="scripts/manager_aptus_character.lua" />
        <script name="APTUSConflicts" file="scripts/manager_aptus_conflicts.lua" />
        <script name="APTUSRank" file="scripts/manager_aptus_rank.lua" />
        <script name="APTUSSkillsManager" file="scripts/manager_aptus_skills.lua" />

        <!-- Textos traducibles -->
        <includefile source="strings/strings_aptus.xml" />

        <includefile source="campaign/record_char_header_aptus.xml" />
        <includefile source="campaign/record_char_navigation_aptus.xml" />
        <includefile source="campaign/record_symbiote_appearance_aptus.xml" />
        <includefile source="campaign/record_conflict_row_aptus.xml" />
        <includefile source="campaign/record_char_identity_content_aptus.xml" />
